<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Cours15___MenuBar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Cours15___MenuBar"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Cours15 - MenuBar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Fichier">
                <MenuFlyoutSubItem Text="Nouveau">
                    <MenuFlyoutItem Text="Produit" Click="MenuFlyoutItem_Click" Tag="nouveau"/>
                    <MenuFlyoutItem Text="Commande" Click="MenuFlyoutItem_Click" Tag="nouveau"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="Ouvrir">
                    <MenuFlyoutItem Text="Fichier récent" Click="MenuFlyoutItem_Click" Tag="ouvrir"/>
                    <MenuFlyoutItem Text="Parcourir" Click="MenuFlyoutItem_Click" Tag="ouvrir"/>
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Sauvegarder" Click="MenuFlyoutItem_Click" Tag="sauvegarder"/>
                <MenuFlyoutItem Text="Exporter" Click="MenuFlyoutItem_Click"/>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Quitter" Click="MenuFlyoutItem_Click" Tag="quitter"/>
            </MenuBarItem>
            <MenuBarItem Title="Édition">
                <MenuFlyoutItem Text="Annuler"/>
                <MenuFlyoutItem Text="Copier"/>
                <MenuFlyoutItem Text="Couper"/>
                <MenuFlyoutItem Text="Coller"/>
            </MenuBarItem>
            <MenuBarItem Title="Aide">
                <MenuFlyoutItem Text="À Propros"/>
            </MenuBarItem>
        </MenuBar>

        <NavigationView Grid.Row="1" x:Name="navView" PaneDisplayMode="Left" PaneTitle="Mon titre" SelectionChanged="navView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Zone 1"/>
                <NavigationViewItem Content="Clients" x:Name="iClients" Icon="People" Tag="page1"/>
                <NavigationViewItem Content="Agenda" x:Name="iAgenda" Icon="Calendar" Tag="page2"/>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Commandes" x:Name="iCommandes" Icon="Shop"/>
            </NavigationView.MenuItems>

            <Frame x:Name="mainFrame" />

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Déconnexion" x:Name="iDeconnexion" Icon="Switch" Tag="deconnexion" />
                <NavigationViewItem Content="Aide" x:Name="iAide" Icon="Help" Tag="aide"/>
            </NavigationView.FooterMenuItems>
        </NavigationView>
    </Grid>
</Window>
