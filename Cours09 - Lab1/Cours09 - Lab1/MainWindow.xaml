    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Margin="10" Background="AliceBlue" Grid.RowSpan="2">
            <TextBox x:Name="tbxTitre" Width="200" Margin="0,0,0,10" Header="Titre de la recette"/>
            <TextBlock x:Name="tbkTitre" Foreground="Red"/>
            <ComboBox x:Name="cmbCat" SelectedIndex="-1" Header="Catégorie" Margin="40,0,0,10">
                <x:String>Entrée</x:String>
                <x:String>Plat principal</x:String>
                <x:String>Dessert</x:String>
            </ComboBox>
            <TextBlock x:Name="tbkCat" Foreground="Red"/>
            <TextBox x:Name="tbxDuree" Width="200" Margin="0,0,0,10" Header="Durée de la recette"/>
            <TextBlock x:Name="tbkDuree" Foreground="Red"/>
            <TextBox x:Name="tbxUrl" Width="200" Margin="0,0,0,10" Header="URL de la photo"/>
            <TextBlock x:Name="tbkUrl" Foreground="Red"/>
            <TextBox x:Name="tbxDesc" Height="150" Width="200" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Header="Description"/>
            <TextBlock x:Name="tbkDesc" Foreground="Red"/>
            <Button x:Name="btnAjouter" Width="200" Margin="40,0,0,10" Click="btnAjouter_Click" Background="LightGreen">Ajouter</Button>
        </StackPanel>

        <TextBlock x:Name="tbxListe" Text="Liste des recettes" FontSize="40" Grid.Column="1"/>

        <GridView x:Name="lvRecettes" Grid.Row="1" Grid.Column="1" Background="Beige">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:Recette">
                    <Grid Background="Black" MaxWidth="500" MaxHeight="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Image Source="{x:Bind UrlImage, Mode=OneWay}" Width="200" Margin="5"/>

                        <StackPanel Orientation="Vertical" Spacing="10" Background="AliceBlue" Margin="5" Padding="5" Grid.Column="1">
                            <TextBlock Text="{x:Bind Titre, Mode=OneWay}" FontSize="30" Foreground="MediumAquamarine" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="30">
                                <TextBlock Text="{x:Bind Categorie, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold"/>
                                <TextBlock Text="{x:Bind Duree, Mode=OneWay}" FontSize="10" FontWeight="ExtraBold"/>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Width="200" TextWrapping="Wrap" FontSize="15"/>
                            <Button x:Name="btnUpd" Click="btnUpd_Click" Background="Yellow">
                                Modifier
                            </Button>
                            <Button x:Name="btnDel" Click="btnDel_Click" Background="OrangeRed">
                                Supprimer
                            </Button>
                        </StackPanel>
                    </Grid>

                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

    </Grid>
</Window>
